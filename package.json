{
  "name": "oxc-config-hope",
  "version": "0.3.15",
  "description": "Personal configuration for oxc.",
  "keywords": [
    "eslint",
    "oxc",
    "oxfmt",
    "oxlint",
    "prettier",
    "typescript"
  ],
  "license": "ISC",
  "author": {
    "name": "Mister-Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": {
    "url": "git+https://github.com/Mister-Hope/oxc-config-hope.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./dist/oxfmt.js"
    },
    "./oxlint": {
      "types": "./dist/oxlint.d.ts",
      "default": "./dist/oxlint.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --fix && oxfmt .",
    "lint:check": "oxlint && oxfmt --check .",
    "prepublish": "pnpm build",
    "test": "vitest"
  },
  "devDependencies": {
    "@mr-hope/tsconfig": "0.0.4",
    "publint": "0.3.25",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "oxfmt": ">=0.72.0 && < 1.0.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": ">=7.0.2"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.23.4 || ^24.22.1 || ^26.13.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
